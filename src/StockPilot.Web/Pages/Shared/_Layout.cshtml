@using System.Security.Claims
@{ var signedIn = User.Identity?.IsAuthenticated == true; var current = ViewContext.RouteData.Values["page"]?.ToString(); }
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="description" content="StockPilot — a clear view of your inventory, orders, and team operations." />
<title>@ViewData["Title"] · StockPilot</title>
<link rel="icon" href="~/favicon.svg" type="image/svg+xml" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<a class="skip-link" href="#main">Skip to content</a>
@if(signedIn) {
<aside class="sidebar">
<a class="brand" asp-page="/Index">
<span class="brand-icon">s<span>↗</span>
</span>stockpilot<span class="brand-dot">.</span>
</a>
<div class="workspace">
<span class="workspace-avatar">@((User.FindFirstValue("company") ?? "W")[..1].ToUpperInvariant())</span>
<div>
<strong>@User.FindFirstValue("company")</strong>
<small>Workspace</small>
</div>
<span>⌄</span>
</div>
<span class="nav-caption">WORKSPACE</span>
<nav aria-label="Main navigation">
<a class="@(current == "/Index" ? "active" : "")" asp-page="/Index">
<span>◫</span>Overview</a>
<a class="@(current == "/Inventory" ? "active" : "")" asp-page="/Inventory">
<span>▦</span>Inventory</a>
<a class="@(current == "/Orders" ? "active" : "")" asp-page="/Orders">
<span>⇄</span>Orders</a>
<a class="@(current == "/Activity" ? "active" : "")" asp-page="/Activity">
<span>◷</span>Activity</a>@if(User.IsInRole("Admin")) { <a class="@(current == "/Team" ? "active" : "")" asp-page="/Team">
<span>♧</span>Team</a> }</nav>
<div class="sidebar-note">
<span class="sparkle">✳</span>
<strong>Less guesswork.<br />More good decisions.</strong>
<p>Your stock, in the right place.</p>
</div>
<div class="profile">
<span class="profile-avatar">@((User.Identity?.Name ?? "U")[..1].ToUpperInvariant())</span>
<div>
<strong>@User.Identity?.Name</strong>
<small>@User.FindFirstValue(ClaimTypes.Role)</small>
</div>
<form method="post" asp-page="/Account/Logout">
<button class="logout" title="Sign out" aria-label="Sign out">↪</button>
</form>
</div>
</aside>
<div class="app-shell">
<header class="topbar">
<div>
<span class="muted">Workspace</span>
<span class="breadcrumb-separator">/</span>
<strong>@ViewData["Title"]</strong>
</div>
<div class="topbar-right">
<span class="status-dot">
</span>
<span>Workspace connected</span>
<span class="topbar-date">@DateTime.UtcNow.ToString("MMM dd, yyyy") UTC</span>
</div>
</header>
<main id="main" class="main-content">@if(TempData["Success"] is string success) { <div class="notice success" role="status">✓ @success</div> }@if(TempData["Error"] is string error) { <div class="notice error" role="alert">@error</div> }@RenderBody()<footer class="page-footer">
<span>StockPilot · Make room for what’s next.</span>
<a href="https://github.com/ZiadMaghraby/StockPilot" target="_blank" rel="noopener noreferrer">View on GitHub ↗</a>
</footer>
</main>
</div>
} else { <header class="public-header">
<a class="brand" asp-page="/Index">
<span class="brand-icon">s<span>↗</span>
</span>stockpilot<span class="brand-dot">.</span>
</a>
<a href="https://github.com/ZiadMaghraby/StockPilot" target="_blank" rel="noopener noreferrer">Built for clarity ↗</a>
</header>
<main id="main" class="public-main">@RenderBody()</main> }
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

